{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludique.dev/ftm/schema/person.schema.json",
  "title": "FTM person research record",
  "description": "One file per person, written to research/<slug>.json. Matches the id and slug of window.RESEARCH.people so it can be merged without reshaping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "name", "researched_at", "outcome", "queries", "sources", "findings"],
  "properties": {
    "id": { "type": "integer", "minimum": 1, "maximum": 100 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "entity_group": {
      "type": "string",
      "description": "Set when several people share the same company (walmart, koch, mars, msc, chanel). Company-level findings must then be identical across the group."
    },
    "researched_at": { "type": "string", "format": "date" },
    "outcome": { "enum": ["specific_sources_found", "no_specific_source_found"] },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Every search query actually run, for audit."
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "proposal": { "$ref": "#/$defs/proposal" },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "$defs": {
    "theme": {
      "enum": ["climate", "politics", "labour", "platforms", "finance", "legal", "public-money", "inheritance", "military", "housing", "epstein", "philanthropy", "health", "tax"]
    },
    "date_partial": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "publisher", "publisher_type", "names_subject", "accessed"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Local id, unique within this file. The merge prefixes it with the slug." },
        "label": { "type": "string", "maxLength": 90, "description": "Format used by the site: 'Publisher • short title (year)'." },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publisher": { "type": "string" },
        "publisher_type": { "enum": ["court", "government", "regulator", "legislature", "intergovernmental", "academic", "ngo", "press", "company", "other"] },
        "names_subject": { "type": "boolean", "description": "True only if the document itself names this person or their company. Generic reports about billionaires are false." },
        "published": { "$ref": "#/$defs/date_partial" },
        "accessed": { "type": "string", "format": "date" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "theme", "level", "entity", "claim", "evidence_type", "date", "source_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^f[0-9]+$" },
        "direction": { "enum": ["concern", "counterweight"] },
        "theme": { "$ref": "#/$defs/theme" },
        "level": { "enum": ["individual", "company", "family", "foundation"], "description": "Who the source is about. A company finding must never be written as a personal act." },
        "entity": { "type": "string", "description": "The person, company or foundation the finding concerns." },
        "claim": { "type": "string", "maxLength": 400, "description": "Own words, at most two sentences, no quote longer than 15 words." },
        "evidence_type": {
          "enum": ["criminal_conviction", "guilty_plea", "final_ruling", "settlement", "regulatory_penalty", "sanctions", "indictment", "pending_case", "allegation", "legislative_finding", "official_report", "investigative_reporting", "company_disclosure", "documented_giving"]
        },
        "date": { "$ref": "#/$defs/date_partial" },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tags", "status", "note", "evidence", "rationale"],
      "description": "A suggestion only. The merge never applies status automatically.",
      "properties": {
        "tags": { "type": "array", "items": { "$ref": "#/$defs/theme" } },
        "status": { "enum": ["red", "orange", "green"] },
        "note": { "type": "string", "maxLength": 500, "description": "Replacement for the site's note field, same tone: says what is established and what is not." },
        "evidence": { "type": "string", "maxLength": 60, "description": "Short evidence label, e.g. 'Settlement • company'." },
        "rationale": { "type": "string", "maxLength": 600 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "results", "passed"],
      "properties": {
        "checked_at": { "type": "string", "format": "date" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "verdict"],
            "properties": {
              "finding_id": { "type": "string" },
              "verdict": { "enum": ["supported", "partial", "unsupported", "unreachable"] },
              "comment": { "type": "string" }
            }
          }
        },
        "passed": { "type": "boolean", "description": "True once every remaining finding is 'supported'." }
      }
    }
  }
}
